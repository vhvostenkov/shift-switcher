[Unit]
Description=VHVost transactional product email queue
After=network-online.target
ConditionPathExists=/opt/shift-switcher/config/service-live.json
[Service]
Type=oneshot
User=shift-switcher
WorkingDirectory=/opt/shift-switcher/app
ExecStart=/opt/shift-switcher/venv/bin/python -m commerce.delivery --config /opt/shift-switcher/config/service-live.json --data /opt/shift-switcher/data-live --send
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/shift-switcher/data-live
MemoryMax=128M
