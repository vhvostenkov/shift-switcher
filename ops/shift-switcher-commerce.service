[Unit]
Description=Shift Switcher independent commerce service (RF)
After=network-online.target
Wants=network-online.target
[Service]
User=shift-switcher
WorkingDirectory=/opt/shift-switcher/app
ExecStart=/opt/shift-switcher/venv/bin/python -m commerce.service --config /opt/shift-switcher/config/service-demo.json --data /opt/shift-switcher/data
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/shift-switcher/data
MemoryMax=256M
TasksMax=64
[Install]
WantedBy=multi-user.target
